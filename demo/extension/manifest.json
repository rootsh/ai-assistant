{
  "manifest_version": 3,
  "name": "RTM AI Assistant — Demo",
  "version": "0.1.2",
  "version_name": "0.0.1.b3",
  "description": "Demonstra leitura explícita de campos visíveis da aba atual e chat simulado.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "optional_host_permissions": ["https://*.sysaidit.com/*", "https://rtm.sysaidit.co/*"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Abrir RTM AI Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
